# ─────────────────────────────────────────────────────────────
#  EcoMarket — Variables de entorno (copiar a .env o definir
#  en Render/Railway). Copia este archivo como base:
#      cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Clave secreta de Flask (¡cámbiala en producción!)
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Ruta de la base de datos SQLite (opcional)
# DATABASE_URL=data/ecomarket.db

# Carpeta de imágenes subidas (opcional)
# UPLOADS_DIR=static/uploads

# ── Inicio de sesión con Google ──────────────────────────────
# 1) Crea credenciales OAuth en Google Cloud Console
# 2) Añade tus orígenes autorizados (http://localhost:5000, tu dominio)
# 3) Copia aquí el Client ID (termina en .apps.googleusercontent.com)
# Ver GUIA_GOOGLE_LOGIN.md para el paso a paso.
GOOGLE_CLIENT_ID=

# Modo depuración de Flask (true/false)
FLASK_DEBUG=false