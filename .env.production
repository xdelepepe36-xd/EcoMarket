# EcoMarket - Configuración de Producción
# Variables de entorno para despliegue en producción

# Flask
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=CAMBIAR_ESTO_POR_UNA_CLAVE_SEGURA_ALEATORIA

# Base de Datos
DATABASE_URL=sqlite:///data/ecomarket.db

# Archivos
UPLOADS_DIR=static/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB

# Servidor
HOST=0.0.0.0
PORT=5000

# SSL/TLS (opcional - configurar en reverse proxy)
# SSL_CERT=/path/to/cert.pem
# SSL_KEY=/path/to/key.pem

# Logging
LOG_LEVEL=INFO
LOG_FILE=ecomarket.log

# Caché
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# Paginación
ITEMS_PER_PAGE=12
ITEMS_PER_PAGE_SMALL=6

# Rate Limiting
RATE_LIMIT_AUTHENTICATED=100
RATE_LIMIT_UNAUTHENTICATED=30

# Moneda
MONEDA=S/
SITIO_NOMBRE=EcoMarket
ANIO_ACTUAL=2026

# Google Analytics (opcional)
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Stripe (opcional - para pagos)
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx

# PayPal (opcional - para pagos)
PAYPAL_CLIENT_ID=xxxxxxxxxx

# Facebook (opcional - para login social)
FACEBOOK_APP_ID=xxxxxxxxxx
FACEBOOK_APP_SECRET=xxxxxxxxxx

# Google (opcional - para login social)
GOOGLE_CLIENT_ID=xxxxxxxxxx
GOOGLE_CLIENT_SECRET=xxxxxxxxxx

# Email (opcional - para notificaciones)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=xxxxxxxxxx@gmail.com
MAIL_PASSWORD=xxxxxxxxxx
MAIL_DEFAULT_SENDER=hola@ecomarket.com

# Push Notifications (opcional)
VAPID_PUBLIC_KEY=xxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxx
VAPID_SUBJECT=mailto:hola@ecomarket.com